// Rename this file to playbrick.config.js — it is git-ignored (local to each project).
// The plugin reads this file when you run the build from the playground.

module.exports = {
  // Scaffold mode this playground was generated for. Keep in sync with the
  // PlayBrick admin setting.
  mode: 'tailwind',

  // Where the production build is written (relative to this file or absolute).
  // Must live inside wp-content/uploads/ so WordPress can compute the URL.
  outDir: '../wp-content/uploads/assets',

  // Who enqueues the assets. Use 'plugin' for the default plugin-managed
  // enqueue, or 'child_theme' when the active child theme will enqueue them.
  enqueueStrategy: 'plugin',

  // Absolute path to wp-load.php. Used by export-bricks-source.php to read
  // classes stored in Bricks Builder before Tailwind compiles.
  wpLoadPath: '../wp-load.php',
};
