// Rename this file to playbrick.config.js — it is git-ignored (local to each project).
// Then run: pnpm run setup

module.exports = {
  // Scaffold mode this playground was generated for. Keep in sync with the
  // PlayBrick admin setting. The plugin re-writes this on config generation.
  mode: 'tailwind',

  // Where the production build is written (relative to this file or absolute).
  // Must live inside wp-content/uploads/ so WordPress can compute the URL.
  outDir: '../wp-content/uploads/assets',

  // Path to your child theme (relative to this file or absolute).
  // Used by `pnpm run setup` to wire in the enqueue code.
  childTheme: '../wp-content/themes/my-child-theme',

  // (Optional) Override the subfolder appended to wp_upload_dir()['baseurl'] in prod mode.
  // By default it's derived from the last segment of outDir (e.g. 'assets').
  // Set this only if auto-detection gives the wrong result.
  //   assetsSubdir: 'assets',

  // (Optional) Existing PHP file inside childTheme where the enqueue hook should be appended.
  // Use this when the theme already has a dedicated enqueue file already loaded by functions.php.
  // If omitted, setup creates includes/playbrick-enqueue.php and adds a require_once to functions.php.
  //
  // Traditional theme (no dedicated enqueue file — setup patches functions.php directly):
  //   enqueueFile: '',
  //
  // snn-brx-child-theme (has its own enqueue file, functions.php must not be touched):
  //   enqueueFile: 'includes/features/enqueue-scripts.php',
  //
  // Any theme with a custom enqueue file:
  //   enqueueFile: 'inc/enqueue.php',
  enqueueFile: '',

  // Bricks Builder note: dynamic utility classes stored in the Bricks database
  // are NOT captured by @source glob scanning at build time.
  // Add a Tailwind safelist in dev.css for any Bricks-managed utilities, e.g.:
  //   @source safe 'bg-primary text-white px-4 py-2 rounded';
};
